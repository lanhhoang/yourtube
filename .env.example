YT_DATA_DIR=./tmp/data
YT_DOWNLOADS_DIR=./tmp/downloads
YT_LOG_LEVEL=INFO
# YT_HOST=0.0.0.0  # listen on the LAN (plain http)
# Web Push (VAPID). Keys are generated into <data dir>/vapid.json when unset.
# YT_VAPID_PRIVATE_KEY=
# YT_VAPID_PUBLIC_KEY=
# YT_VAPID_SUBJECT=mailto:you@example.com  # must be mailto: or https: without a path (not localhost)
